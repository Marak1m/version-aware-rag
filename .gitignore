# Python
.venv/
__pycache__/
.pytest_cache/
*.pyc
*.egg-info/
build/
dist/

# Built library environments (locks and manifest are committed)
envs/*/.venv/

# Downloaded tokenizer (pinned by sha256 in configs/models.yaml)
data/tokenizer/

# Model weights, in any form
models/
*.gguf
*.safetensors
*.bin

# Runs: keep report.md, run.json and the compressed results of each run; ignore the response
# cache, raw traces, uncompressed results and everything else a run writes.
runs/*
!runs/*/
runs/*/*
!runs/*/report.md
!runs/*/metrics.json
!runs/*/run.json
!runs/*/results.jsonl.gz
!runs/*/audit_sample.jsonl
!runs/*/audit_sample.md
!runs/smoke-*.json
runs/_cache/

# OpenRouter key (read by the client at run time; never commit)
openrouter-api-key
OPENROUTER_API_KEY
.env

# OpenRouter request logs from 2026-10-21 on: committed gzipped (<date>-<backend>.jsonl.gz); the
# raw files stay local (each is close to GitHub's 50 MB warning).
logs/openrouter/2026-10-2[1-9]-*.jsonl
